<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LibraryManagement</RootNamespace>
    <AssemblyName>LibraryManagement</AssemblyName>
  </PropertyGroup>

  <ItemGroup Condition="'$(OfflineSqlite)' == ''">
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <!-- Sandbox smoke tests only: build without NuGet using an external SQLite binding. -->
  <PropertyGroup Condition="'$(OfflineSqlite)' != ''">
    <DefineConstants>$(DefineConstants);OFFLINE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(OfflineSqlite)' != ''">
    <Compile Include="$(OfflineSqlite)" />
  </ItemGroup>

</Project>
