@{
    var isAdmin = User.IsInRole(Roles.Admin);
    var isStudent = User.IsInRole(Roles.Student);
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string Active(string prefix) => page.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "is-active" : "";
    var flash = TempData["Flash"] as string;
    var flashKind = TempData["FlashKind"] as string ?? "success";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t ? $"{t} · " : "")Shelf — Library Management</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="topbar">
        <div class="container topbar-inner">
            <a class="brand" href="/">
                <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="4" y="6" width="6" height="20" rx="1.5"/><rect x="12" y="4" width="6" height="22" rx="1.5"/><rect x="20.5" y="7" width="6" height="19" rx="1.5" transform="rotate(-12 23.5 16.5)"/></svg>
                <span>Shelf</span>
            </a>
            <nav class="nav" aria-label="Main">
                <a class="@(page == "/Index" ? "is-active" : "")" href="/">Catalogue</a>
                @if (isStudent)
                {
                    <a class="@Active("/MyLoans")" href="/MyLoans">My loans</a>
                }
                @if (isAdmin)
                {
                    <a class="@(page == "/Admin/Index" ? "is-active" : "")" href="/Admin">Dashboard</a>
                    <a class="@Active("/Admin/Book")" href="/Admin/Books">Books</a>
                    <a class="@Active("/Admin/Student")" href="/Admin/Students">Students</a>
                    <a class="@Active("/Admin/Loans")" href="/Admin/Loans">Loans</a>
                }
            </nav>
            <div class="account">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="who">
                        <span class="avatar" aria-hidden="true">@Display.Initials(User.Identity.Name ?? "?")</span>
                        <span class="who-text"><strong>@User.Identity.Name</strong><small>@(isAdmin ? "Admin" : "Student")</small></span>
                    </span>
                    <form method="post" asp-page="/Account/Logout">
                        <button class="btn btn-ghost btn-sm" type="submit">Sign out</button>
                    </form>
                }
                else
                {
                    <a class="btn btn-ghost btn-sm" href="/Account/Login">Sign in</a>
                    <a class="btn btn-primary btn-sm" href="/Account/Register">Join</a>
                }
            </div>
        </div>
    </header>

    <main id="main" class="container">
        @if (!string.IsNullOrEmpty(flash))
        {
            <div class="flash flash-@flashKind" role="status">@flash</div>
        }
        @RenderBody()
    </main>

    <footer class="container footer">
        <span>Shelf · Library Management System</span>
        <span>ASP.NET Core · SQLite / SQL Server</span>
    </footer>
</body>
</html>
